# Copy to .env and fill in local secrets. Do not commit .env.

# Local/offline default:
AUTORESEARCH_LLM_PROVIDER=mock

# OpenAI-compatible chat-completions provider:
# AUTORESEARCH_LLM_PROVIDER=openai-compatible
# AUTORESEARCH_LLM_BASE_URL=https://api.openai.com/v1
# AUTORESEARCH_LLM_API_KEY=sk-...
# AUTORESEARCH_LLM_MODEL=gpt-4.1

# Anthropic Messages API provider:
# AUTORESEARCH_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AUTORESEARCH_LLM_MODEL=claude-3-5-sonnet-latest

# Remote GPU benchmark execution (Phase 1):
# AUTORESEARCH_REMOTE_HOST=<lambda-instance-ip>
# AUTORESEARCH_REMOTE_USER=ubuntu
# AUTORESEARCH_REMOTE_KEY=gigachad.pem
# AUTORESEARCH_REMOTE_PORT=22
# AUTORESEARCH_REMOTE_ROOT=/home/ubuntu/autoresearch
# AUTORESEARCH_REMOTE_DATA_DIR=/home/ubuntu/data/darcy
